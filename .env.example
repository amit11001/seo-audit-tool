# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Public origin, used for canonical tags and sitemap.xml.
# Set this to your deployed URL in production.
BASE_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=seo_audit
DB_POOL_SIZE=5
# Set to true for managed MySQL (Aiven, PlanetScale, Railway).
DB_SSL=false

FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=5242880
